{
  "name": "legend-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Legend in the Mist character sheet and play companion.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "lint": "oxlint src vite.config.ts",
    "lint:fix": "oxlint --fix src vite.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
